{
  "name": "valid-gtin",
  "version": "3.0.0",
  "keywords": [
    "gtin",
    "validate"
  ],
  "license": "MIT",
  "author": "0xflotus",
  "repository": "github:0xflotus/valid-gtin",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "precoverage": "npm run minify",
    "coverage": "vp test run --coverage",
    "prepublishOnly": "npm run check && npm run test",
    "check": "vp check src test vite.config.js commitlint.config.mjs .size-limit.cjs package.json",
    "lint": "vp lint src test vite.config.js commitlint.config.mjs .size-limit.cjs",
    "minify": "vp pack",
    "presize": "npm run minify",
    "size": "size-limit",
    "pretest": "npm run minify",
    "test": "vp test run"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "14.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "size-limit": "14.2.0",
    "vite-plus": "1.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
